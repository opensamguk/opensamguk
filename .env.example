# 복사해서 .env로 쓴다. .env는 Git에 올리지 않는다.
DATABASE_URL=postgresql://opensamguk:opensamguk@127.0.0.1:5433/opensamguk
SERVER_PORT=3001
MAIL_TRANSPORT=capture
MAIL_CAPTURE_DIR=.mail-outbox
TEST_DATABASE_URL=postgresql://opensamguk:opensamguk@127.0.0.1:5433/opensamguk_test

# 공개 지도: 지연 시간과 저장 간격(분). 두 프로세스에 같은 값을 쓴다.
PUBLIC_MAP_DELAY_MINUTES=10
PUBLIC_MAP_INTERVAL_MINUTES=5
