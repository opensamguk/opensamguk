{
  "name": "opensamguk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "e2e:public": "playwright test --config playwright.public.config.ts",
    "notice:publish": "tsx --env-file-if-exists=.env tools/notice-publish.ts",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "generate": "pnpm --filter @opensamguk/db generate",
    "lint": "eslint .",
    "lint:text": "tsx tools/lint-text/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm generate && pnpm lint && pnpm lint:text --strict && pnpm format:check && pnpm typecheck && pnpm test && pnpm -s next",
    "e2e": "playwright test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "next": "node tools/next-task.mjs",
    "world:create": "pnpm --filter @opensamguk/engine world:create",
    "engine:run": "pnpm --filter @opensamguk/engine engine:run",
    "db:migrate": "pnpm --filter @opensamguk/db migrate",
    "test:int": "pnpm generate && tsx --env-file-if-exists=.env tools/run-integration.ts",
    "test:authz": "pnpm generate && tsx --env-file-if-exists=.env tools/run-authz.ts",
    "world:start": "pnpm --filter @opensamguk/engine world:start",
    "world:pause": "pnpm --filter @opensamguk/engine world:pause",
    "world:resume": "pnpm --filter @opensamguk/engine world:resume",
    "world:status": "pnpm --filter @opensamguk/engine world:status",
    "world:accelerate": "pnpm --filter @opensamguk/engine world:accelerate",
    "world:realtime": "pnpm --filter @opensamguk/engine world:realtime",
    "portraits:map": "tsx tools/portrait-map/generate.ts",
    "sim": "tsx tools/sim/cli.ts",
    "build:public": "pnpm --filter @opensamguk/web exec vite build --mode public && pnpm assets:check",
    "assets:check": "tsx tools/public-assets/check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
