// 데이터 모델 개요: docs/product/data-model.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model World {
  id              String      @id @default(uuid())
  name            String
  scenarioKey     String
  mapKey          String
  unitSetKey      String
  seed            String
  startYear       Int
  endYear         Int?
  clockMode       WorldClockMode @default(REALTIME)
  outcomeFromSequence Int @default(0)
  result          WorldResult?
  turnTermMinutes Int
  status          WorldStatus @default(PREOPEN)
  clockTick       Int         @default(0)
  clockAnchorAt   DateTime?
  clockRevision   Int         @default(0)
  startedAt       DateTime?
  endedAt         DateTime?
  initialStateHash String
  statRules       Json
  unitSet         Json
  createdAt       DateTime    @default(now())
  nations         Nation[]
  cities          City[]
  generals        General[]
  diplomacies     Diplomacy[]
  engineLease     EngineLease?
  engineHeartbeat EngineHeartbeat?
  monthlyTick     Int         @default(0)
  actionSequence  Int         @default(0)
  replayOrigin    Json?
  inputEvents     InputEvent[]
  nationHistory   NationHistory[]
  yearbooks       YearbookSnapshot[]
  removedNations  RemovedNation[]
  commandMeta     Json?
  battleLogs      BattleLog[]
  ranking         RankingSnapshot?
  publicMaps      PublicMapSnapshot[]
  messages        Message[]
  notices         Notice[]
}

enum WorldStatus {
  PREOPEN
  RUNNING
  PAUSED
  ENDED
}

enum WorldClockMode {
  REALTIME
  ACCELERATED
}

enum WorldEndReason {
  UNIFIED
  END_YEAR
}

model WorldResult {
  worldId          String @id
  world            World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  reason           WorldEndReason
  winnerNationId   Int?
  winnerName       String?
  winnerColor      String?
  endedYear        Int
  endedMonth       Int
  endedTick        Int
  endedSequence    Int
  remainingNations Int
  finalStateHash   String
  endedAt          DateTime
}

enum DiplomacyState {
  WAR
  DECLARED
  NON_AGGRESSION
}

model Nation {
  worldId        String
  id             Int
  name           String
  color          String
  gold           Int
  rice           Int
  description    String
  tech           Float
  philosophy     String
  level          Int
  capitalCityKey Int?
  isNpc          Boolean @default(true)
  world          World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  capital        City?   @relation("Capital", fields: [worldId, capitalCityKey], references: [worldId, cityKey], onDelete: NoAction)
  cities         City[]  @relation("OwnedCities")
  generals       General[]
  diplomacyAsA   Diplomacy[] @relation("NationA")
  diplomacyAsB   Diplomacy[] @relation("NationB")
  turns          NationTurn[]
  notice         String @default("")
  noticeRevision Int @default(0)
  noticeUpdatedAt DateTime?
  noticeUpdatedBy String?

  @@id([worldId, id])
}

model City {
  worldId       String
  cityKey       Int
  name          String
  level         Int
  region        Int
  x             Float
  y             Float
  connections   Int[]
  nationId      Int?
  population    Int
  populationMax Int
  agriculture   Int
  agricultureMax Int
  commerce      Int
  commerceMax   Int
  security      Int
  securityMax   Int
  defence       Int
  defenceMax    Int
  wall          Int
  wallMax       Int
  trust         Float
  supplied      Boolean
  world         World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  nation        Nation? @relation("OwnedCities", fields: [worldId, nationId], references: [worldId, id], onDelete: NoAction)
  capitalOf     Nation[] @relation("Capital")
  generals      General[]

  @@id([worldId, cityKey])
  @@unique([worldId, name])
  @@index([worldId, nationId])
}

model General {
  worldId        String
  id             Int
  userId         String?
  user           User? @relation(fields: [userId], references: [id], onDelete: NoAction)
  affinity       Int
  name           String
  portraitId     Int?
  nationId       Int?
  cityKey        Int
  leadership     Int
  strength       Int
  intel          Int
  officerLevel   Int
  birthYear      Int
  deathYear      Int
  activeFromYear Int
  personality    String?
  special        String?
  gold           Int
  rice           Int
  crew           Int
  crewType       Int
  train          Int
  atmos          Int
  experience     Int
  dedication     Int
  battleWins     Int @default(0)
  captures       Int @default(0)
  age            Int
  injury         Int
  nextTurnTick   Int
  turnRevision   Int @default(0)
  noticeSeen     Json?
  messageReads   MessageRead[]
  turns          GeneralTurn[]
  logs           GeneralLog[]
  battleLogs     BattleLog[]
  world          World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  nation         Nation? @relation(fields: [worldId, nationId], references: [worldId, id], onDelete: NoAction)
  city           City    @relation(fields: [worldId, cityKey], references: [worldId, cityKey], onDelete: NoAction)

  @@id([worldId, id])
  @@unique([worldId, userId])
  @@index([worldId, nationId])
  @@index([worldId, cityKey])
  @@index([worldId, nextTurnTick, id])
}

model EngineLease {
  worldId      String @id
  ownerId      String
  fencingToken Int
  expiresAt    DateTime
  world        World @relation(fields: [worldId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model EngineHeartbeat {
  worldId   String   @id
  at        DateTime @db.Timestamptz(3)
  lastTick  Int
  lagMs     Int
  lastError String?
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model GeneralTurn {
  worldId    String
  generalId  Int
  slot       Int
  commandKey String @default("rest")
  args       Json @default("{}")
  general    General @relation(fields: [worldId, generalId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([worldId, generalId, slot])
}

model GeneralLog {
  id         BigInt @id @default(autoincrement())
  worldId    String
  generalId  Int
  tick       Int
  commandKey String
  kind       String
  text       String
  createdAt  DateTime @default(now())
  general    General @relation(fields: [worldId, generalId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([worldId, generalId, tick])
}

model NationTurn {
  worldId    String
  nationId   Int
  slot       Int
  commandKey String @default("nation_rest")
  args       Json @default("{}")
  nation     Nation @relation(fields: [worldId, nationId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([worldId, nationId, slot])
}

model BattleLog {
  worldId   String
  tick      Int
  attackerId Int
  generalId Int
  text      String
  world     World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  general   General @relation(fields: [worldId, generalId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([worldId, tick, attackerId, generalId])
}

enum UserStatus {
  ACTIVE
  SANCTIONED
  WITHDRAWN
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  sessions     Session[]
  generals     General[]
}

model Session {
  id        String @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Diplomacy {
  worldId   String
  nationA   Int
  nationB   Int
  state     DiplomacyState
  untilTick Int
  world     World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  a         Nation @relation("NationA", fields: [worldId, nationA], references: [worldId, id], onDelete: NoAction)
  b         Nation @relation("NationB", fields: [worldId, nationB], references: [worldId, id], onDelete: NoAction)

  @@id([worldId, nationA, nationB])
}

enum InputEventStatus {
  PENDING
  APPLIED
  REJECTED
}

model InputEvent {
  id             BigInt @id @default(autoincrement())
  worldId        String
  userId         String
  generalId      Int?
  kind           String
  idempotencyKey String
  payload        Json
  status         InputEventStatus @default(PENDING)
  sequence       Int?
  result         Json?
  createdAt      DateTime @default(now())
  world          World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, userId, idempotencyKey])
  @@unique([worldId, sequence])
  @@index([worldId, status, id])
}

model NationHistory {
  worldId  String
  tick     Int
  nationId Int
  data     Json
  world    World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, tick, nationId])
}

model YearbookSnapshot {
  worldId   String
  tick      Int
  year      Int
  month     Int
  sequence  Int
  data      Json
  stateHash String
  world     World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  nations   YearbookNation[]

  @@id([worldId, tick])
}

model RemovedNation {
  worldId         String
  nationId        Int
  name            String
  color           String
  removedSequence Int
  removedTick     Int
  world           World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, nationId])
}

model YearbookNation {
  worldId  String
  tick     Int
  nationId Int
  name     String
  color    String
  snapshot YearbookSnapshot @relation(fields: [worldId, tick], references: [worldId, tick], onDelete: Cascade)

  @@id([worldId, tick, nationId])
}

model RankingSnapshot {
  worldId  String @id
  tick     Int
  year     Int
  month    Int
  generals Json
  nations  Json
  world    World @relation(fields: [worldId], references: [id], onDelete: Cascade)
}

model PublicMapSnapshot {
  worldId String
  takenAt DateTime
  tick    Int
  year    Int
  month   Int
  data    Json
  world   World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, takenAt])
}

enum MessageScope {
  PRIVATE
  NATION
  DIPLOMACY
  WORLD
}

model Message {
  id                String        @id @default(uuid())
  worldId           String
  scope             MessageScope
  senderId          Int?
  senderNationId    Int?
  recipientId       Int?
  recipientNationId Int?
  fromParty         Json
  toParty           Json?
  body              String
  sentAt            DateTime      @default(now()) @db.Timestamptz(3)
  year              Int
  month             Int
  world             World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  reads             MessageRead[]

  @@unique([worldId, id])
  @@index([worldId, scope, sentAt, id])
  @@index([worldId, senderId, sentAt])
}

model MessageRead {
  worldId   String
  messageId String
  generalId Int
  message   Message @relation(fields: [worldId, messageId], references: [worldId, id], onDelete: Cascade)
  general   General @relation(fields: [worldId, generalId], references: [worldId, id], onDelete: Cascade)

  @@id([messageId, generalId])
}

enum NoticeScope {
  LOBBY
  WORLD
}

model Notice {
  id          String      @id @default(uuid())
  scope       NoticeScope
  worldId     String?
  title       String?
  body        String
  pinned      Boolean     @default(false)
  publishedAt DateTime    @default(now()) @db.Timestamptz(3)
  world       World?      @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([scope, worldId, publishedAt, id])
}
