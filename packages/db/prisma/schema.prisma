// 데이터 모델 개요: docs/product/data-model.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model World {
  generalBattleStats   GeneralBattleStats[]
  trafficMonthly       WorldTrafficMonthly[]
  npcEntryDrafts       NpcEntryDraft[]
  reputationEvents     ReputationEvent[]
  publicNationEvents   PublicNationEvent[]
  monthlyReviews       MonthlyReview[]
  runtimeOptions       Json?
  equipmentState       Json?
  notificationOutbox   NotificationOutbox[]
  lineageState         Json?
  stratagemCardsState  Json?
  governanceState      Json?
  governanceMovements  GovernanceMovement[]
  logisticsState       Json?
  logisticsMovements   LogisticsMovement[]
  id                   String               @id @default(uuid())
  name                 String
  presetKey            String?
  preset               Json?
  scenarioKey          String
  mapKey               String
  unitSetKey           String
  seed                 String
  startYear            Int
  endYear              Int?
  clockMode            WorldClockMode       @default(REALTIME)
  outcomeFromSequence  Int                  @default(0)
  result               WorldResult?
  turnTermMinutes      Int
  status               WorldStatus          @default(PREOPEN)
  clockTick            Int                  @default(0)
  clockAnchorAt        DateTime?
  clockRevision        Int                  @default(0)
  startedAt            DateTime?
  endedAt              DateTime?
  initialStateHash     String
  statRules            Json
  unitSet              Json
  operationalMap       Json?
  createdAt            DateTime             @default(now())
  nations              Nation[]
  cities               City[]
  generals             General[]
  diplomacies          Diplomacy[]
  diplomaticDocuments  DiplomaticDocument[]
  diplomaticDelegates  DiplomaticDelegate[]
  engineLease          EngineLease?
  engineHeartbeat      EngineHeartbeat?
  monthlyTick          Int                  @default(0)
  actionSequence       Int                  @default(0)
  policyFromSequence   Int?
  treatyFormat         Int?
  personnelFormat      Int?
  replayFormat         Int                  @default(1)
  ruleFeatures         String[]             @default([])
  officeEffects        Json?
  cityOfficeVolunteers Json?
  replayOrigin         Json?
  inputEvents          InputEvent[]
  nationHistory        NationHistory[]
  yearbooks            YearbookSnapshot[]
  removedNations       RemovedNation[]
  commandMeta          Json?
  campaignState        Json?
  cityResourcesState   Json?
  cityRuinsState       Json?
  nationStrategyState  Json?
  preparedTurnsState   Json?
  nationResearchState  Json?
  nationLifecycleState Json?
  battleLogs           BattleLog[]
  ranking              RankingSnapshot?
  publicMaps           PublicMapSnapshot[]
  messages             Message[]
  nationBoardPosts     NationBoardPost[]
  notices              Notice[]
  operations           Operation[]
  extSlices            WorldExtSlice[]
  treaties             Treaty[]
  nationTrust          NationTrust[]
  assignmentOffers     AssignmentOffer[]
  sanctions            Sanction[]
  createRequest        WorldCreateRequest?
  seasonGenerals       SeasonGeneral[]
}

model NpcEntryDraft {
  worldId   String
  userId    String
  nonce     String
  validUntil DateTime
  redrawAt  DateTime
  cards     Json
  world     World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([worldId, userId])
  @@index([worldId, validUntil])
}

model WorldTrafficMonthly {
  worldId   String
  monthTick Int
  generalId Int
  firstAt   DateTime
  lastAt    DateTime
  refresh   BigInt   @default(1)
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, monthTick, generalId])
  @@index([worldId, generalId])
}

model PublicNationEvent {
  id       BigInt @id @default(autoincrement())
  worldId  String
  sequence Int
  tick     Int
  kind     String
  text     String
  nationIds Int[] @default([])
  world    World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([worldId, tick, id])
  @@index([nationIds], type: Gin)
}

model ReputationEvent {
  id          BigInt   @id @default(autoincrement())
  worldId     String
  generalId   Int
  year        Int
  month       Int
  kind        String
  score       Int
  tick        Int
  generalName String
  nationId    Int?
  nationName  String?
  nationColor String?
  cityKey     Int?
  cityName    String?
  createdAt   DateTime @default(now())
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, generalId, year, month, kind])
  @@index([worldId, year, month])
}

model MonthlyReview {
  worldId   String
  year      Int
  month     Int
  tick      Int
  entries   Json
  headline  String?
  createdAt DateTime @default(now())
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, year, month])
  @@unique([worldId, tick])
}

model GovernanceMovement {
  worldId      String
  sequence     Int
  ordinal      Int
  tick         Int
  kind         String
  refId        Int
  holder       String
  holderId     Int
  resource     String
  delta        Int
  fromNationId Int
  toNationId   Int
  world        World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, sequence, ordinal])
  @@index([worldId, tick])
  @@index([worldId, fromNationId, tick])
  @@index([worldId, toNationId, tick])
  @@index([worldId, holder, holderId, tick])
}

model LogisticsMovement {
  worldId  String
  sequence Int
  ordinal  Int
  tick     Int
  holder   String
  holderId Int
  good     String
  delta    Int
  reason   String
  world    World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, sequence, ordinal])
  @@index([worldId, tick])
}

enum WorldCreateStatus {
  PENDING
  DONE
  FAILED
}

model WorldCreateRequest {
  id             String            @id @default(uuid())
  requestedBy    String
  idempotencyKey String
  version        Int               @default(1)
  intentHash     String
  intent         Json
  officeEffects  Json?
  effectiveSeed  String
  plannedWorldId String            @unique
  resolution     Json?
  status         WorldCreateStatus @default(PENDING)
  worldId        String?           @unique
  errorCode      String?
  createdAt      DateTime          @default(now())
  processedAt    DateTime?
  actor          User              @relation(fields: [requestedBy], references: [id], onDelete: NoAction)
  world          World?            @relation(fields: [worldId], references: [id], onDelete: NoAction)

  @@unique([requestedBy, idempotencyKey])
  @@index([status, createdAt, id])
}

enum AssignmentOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
  CANCELLED
}

enum AssignmentOfferResolvedBy {
  RESPONSE
  EXPIRY
}

enum AssignmentOfferCancelReason {
  CITY_LOST
  TARGET_LEFT
  ISSUER_LOST_OFFICE
  NATION_DESTROYED
}

model AssignmentOffer {
  worldId         String
  id              String
  nationId        Int
  issuerGeneralId Int
  targetGeneralId Int
  cityKey         Int
  status          AssignmentOfferStatus
  resolvedBy      AssignmentOfferResolvedBy?
  cancelReason    AssignmentOfferCancelReason?
  createdTick     Int
  expiresTick     Int
  resolvedTick    Int?
  world           World                        @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, id])
}

enum TreatyStatus {
  PROPOSED
  ACTIVE
  REJECTED
  EXPIRED
  ENDED
  BROKEN
}

model Treaty {
  worldId        String
  id             Int
  fromNationId   Int
  toNationId     Int
  clauses        Json
  status         TreatyStatus
  proposedTick   Int
  respondByTick  Int
  startTick      Int?
  endTick        Int?
  closedSequence Int?
  costFrom       Int?
  costTo         Int?
  world          World        @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, id])
  @@index([worldId, status, id])
  @@index([worldId, fromNationId, id])
  @@index([worldId, toNationId, id])
}

model NationTrust {
  worldId        String
  nationId       Int
  brokenTreaties Int
  lastBrokenTick Int
  world          World  @relation(fields: [worldId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([worldId, nationId])
}

model WorldExtSlice {
  worldId String
  key     String
  value   Json
  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, key])
}

enum WorldStatus {
  PREOPEN
  RUNNING
  PAUSED
  ENDED
}

enum WorldClockMode {
  REALTIME
  ACCELERATED
}

enum WorldEndReason {
  UNIFIED
  END_YEAR
}

model WorldResult {
  worldId          String         @id
  world            World          @relation(fields: [worldId], references: [id], onDelete: Cascade)
  reason           WorldEndReason
  winnerNationId   Int?
  winnerName       String?
  winnerColor      String?
  winnerSummary    Json?
  traitDistribution Json?
  finalNations      Json?
  endedYear        Int
  endedMonth       Int
  endedTick        Int
  endedSequence    Int
  remainingNations Int
  finalStateHash   String
  endedAt          DateTime
}

model SeasonGeneral {
  worldId      String
  generalId    Int
  userId       String?
  name         String
  nationId     Int?
  nationName   String?
  nationColor  String?
  officerLevel Int
  dedication   Int
  experience   Int
  wins         Int
  captures     Int
  world        World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([worldId, generalId])
  @@index([userId])
  stratagemSuccesses Int @default(0)
}

enum DiplomacyState {
  WAR
  DECLARED
  NON_AGGRESSION
}

model Nation {
  diplomaticAidUntilMonth Int?
  npcSettings             Json?
  financeRates            Json?
  restrictions            Json?
  diplomaticDelegates DiplomaticDelegate[]
  worldId         String
  id              Int
  name            String
  color           String
  gold            Int
  rice            Int
  description     String
  tech            Float
  philosophy      String
  level           Int
  capitalCityKey  Int?
  isNpc           Boolean            @default(true)
  world           World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  capital         City?              @relation("Capital", fields: [worldId, capitalCityKey], references: [worldId, cityKey], onDelete: NoAction)
  cities          City[]             @relation("OwnedCities")
  generals        General[]
  diplomacyAsA    Diplomacy[]        @relation("NationA")
  diplomacyAsB    Diplomacy[]        @relation("NationB")
  turns           NationTurn[]
  offices         NationOffice[]
  officeTurns     NationOfficeTurn[]
  notice          String             @default("")
  recruitmentNotice String           @default("")
  noticeDirective Json?
  noticeRevision  Int                @default(0)
  noticeUpdatedAt DateTime?
  noticeUpdatedBy String?
  operations      Operation[]

  @@id([worldId, id])
}

model City {
  conflictTick     Int?
  stratagemTick    Int?
  seasonalEvent    String?
  warCasualties    Int?
  conflict         Json?
  conflictOrder    Json?
  worldId          String
  cityKey          Int
  kind             String?
  name             String
  level            Int
  region           Int
  x                Float
  y                Float
  connections      Int[]
  nationId         Int?
  population       Int
  populationMax    Int
  agriculture      Int
  agricultureMax   Int
  commerce         Int
  commerceMax      Int
  security         Int
  securityMax      Int
  defence          Int
  defenceMax       Int
  wall             Int
  wallMax          Int
  trust            Float
  supplied         Boolean
  world            World       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  nation           Nation?     @relation("OwnedCities", fields: [worldId, nationId], references: [worldId, id], onDelete: NoAction)
  capitalOf        Nation[]    @relation("Capital")
  generals         General[]
  appointedOfficers General[] @relation("CityOffice")
  operationTargets Operation[]

  @@id([worldId, cityKey])
  @@unique([worldId, name])
  @@index([worldId, nationId])
}

model General {
  sex               String?
  diplomaticDelegate DiplomaticDelegate?
  worldId           String
  id                Int
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: NoAction)
  affinity          Int
  name              String
  portraitId        Int?
  nationId          Int?
  nationJoinedTick  Int?
  cityKey           Int
  leadership        Int
  strength          Int
  intel             Int
  politics          Int?
  charm             Int?
  officerLevel      Int
  officerCityKey    Int?
  birthYear         Int
  deathYear         Int
  activeFromYear    Int
  removedAt         Int?
  personality       String?
  defenseThreshold  Int?
  proficiency       Json?
  statExperience    Json?
  heritageBenefits  Json?
  heritageSpecialty Json?
  heritageTurnTime Json?
  heritageStatReset Boolean?
  combatSpecial     String?
  special           String?
  gold              Int
  rice              Int
  crew              Int
  crewType          Int
  train             Int
  atmos             Int
  experience        Int
  dedication        Int
  stratagemSuccesses Int @default(0)
  battleWins        Int               @default(0)
  captures          Int               @default(0)
  age               Int
  injury            Int
  nextTurnTick      Int
  turnRevision      Int               @default(0)
  defaultPolicy     String?
  lastActiveTick    Int?
  lastActiveAt      DateTime?
  residenceTick     Int?
  noticeSeen        Json?
  messageReads      MessageRead[]
  turns             GeneralTurn[]
  logs              GeneralLog[]
  battleLogs        BattleLog[]
  operationsCreated Operation[]
  operationMembers  OperationMember[]
  world             World             @relation(fields: [worldId], references: [id], onDelete: Cascade)
  nation            Nation?           @relation(fields: [worldId, nationId], references: [worldId, id], onDelete: NoAction)
  city              City              @relation(fields: [worldId, cityKey], references: [worldId, cityKey], onDelete: NoAction)
  officerCity       City?             @relation("CityOffice", fields: [worldId, officerCityKey], references: [worldId, cityKey], onDelete: NoAction, onUpdate: NoAction, map: "General_officerCityKey_fkey")

  @@id([worldId, id])
  @@unique([worldId, userId])
  @@index([worldId, nationId])
  @@index([worldId, cityKey])
  @@index([worldId, nextTurnTick, id])
}

enum OperationStatus {
  OPEN
  CLOSED
}

model Operation {
  id            String            @id @default(uuid())
  worldId       String
  nationId      Int
  targetCityKey Int
  targetTick    BigInt
  minCrew       Int
  minTrain      Int
  minAtmos      Int
  status        OperationStatus   @default(OPEN)
  createdById   Int
  world         World             @relation(fields: [worldId], references: [id], onDelete: Cascade)
  nation        Nation            @relation(fields: [worldId, nationId], references: [worldId, id], onDelete: Cascade)
  target        City              @relation(fields: [worldId, targetCityKey], references: [worldId, cityKey], onDelete: NoAction)
  createdBy     General           @relation(fields: [worldId, createdById], references: [worldId, id], onDelete: Cascade)
  members       OperationMember[]

  @@unique([worldId, id])
  @@index([worldId, nationId, status, targetTick, id])
}

model OperationMember {
  worldId     String
  operationId String
  generalId   Int
  operation   Operation @relation(fields: [worldId, operationId], references: [worldId, id], onDelete: Cascade)
  general     General   @relation(fields: [worldId, generalId], references: [worldId, id], onDelete: Cascade)

  @@id([operationId, generalId])
  @@index([worldId, generalId])
}

model EngineLease {
  worldId      String   @id
  ownerId      String
  fencingToken Int
  expiresAt    DateTime
  world        World    @relation(fields: [worldId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model EngineHeartbeat {
  worldId   String   @id
  at        DateTime @db.Timestamptz(3)
  lastTick  Int
  lagMs     Int
  lastError String?
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model GeneralTurn {
  worldId    String
  generalId  Int
  slot       Int
  commandKey String  @default("rest")
  args       Json    @default("{}")
  explicit   Boolean
  general    General @relation(fields: [worldId, generalId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([worldId, generalId, slot])
}

model GeneralLog {
  id         BigInt   @id @default(autoincrement())
  worldId    String
  generalId  Int
  tick       Int
  commandKey String
  kind       String
  text       String
  sequence   Int?
  ordinal    Int      @default(0)
  createdAt  DateTime @default(now())
  general    General  @relation(fields: [worldId, generalId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction)
}

model NationTurn {
  worldId    String
  nationId   Int
  slot       Int
  commandKey String @default("nation_rest")
  args       Json   @default("{}")
  nation     Nation @relation(fields: [worldId, nationId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([worldId, nationId, slot])
}

model NationOffice {
  worldId      String
  nationId     Int
  officerLevel Int
  turnRevision Int    @default(0)
  tenure       Int    @default(0)
  nation       Nation @relation(fields: [worldId, nationId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([worldId, nationId, officerLevel])
}

model NationOfficeTurn {
  worldId      String
  nationId     Int
  officerLevel Int
  slot         Int
  commandKey   String @default("nation_rest")
  args         Json   @default("{}")
  nation       Nation @relation(fields: [worldId, nationId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([worldId, nationId, officerLevel, slot])
}

model GeneralBattleStats {
  worldId     String
  generalId   Int
  engagements Int    @default(0)
  wins        Int    @default(0)
  losses      Int    @default(0)
  kills       BigInt @default(0)
  casualties  BigInt @default(0)
  humanEngagements Int @default(0)
  humanKills BigInt @default(0)
  humanCasualties BigInt @default(0)
  lastTick    Int
  world       World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, generalId])
}

enum DiplomaticDocumentStatus {
  PROPOSED
  ACTIVE
  CANCELLED
  REPLACED
}

enum DiplomaticDelegateRole {
  AMBASSADOR
  ADVISER
}

model DiplomaticDelegate {
  worldId   String
  nationId  Int
  generalId Int
  role      DiplomaticDelegateRole
  world     World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  nation    Nation @relation(fields: [worldId, nationId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction, map: "DiplomaticDelegate_nation_fkey")
  general   General @relation(fields: [worldId, generalId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction, map: "DiplomaticDelegate_general_fkey")

  @@id([worldId, generalId])
  @@index([worldId, nationId, role])
}

model DiplomaticDocument {
  worldId         String
  id              Int                      @default(autoincrement())
  requestId       String                   @db.Uuid
  fromNationId    Int
  toNationId      Int
  fromNationName  String
  toNationName    String
  senderId        Int
  senderName      String
  responderName   String?
  previousId      Int?
  status          DiplomaticDocumentStatus @default(PROPOSED)
  brief           String
  detail          String
  responseReason  String?
  createdAt       DateTime                 @default(now())
  world           World                    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  previous        DiplomaticDocument?      @relation("DocumentHistory", fields: [worldId, previousId], references: [worldId, id], onDelete: NoAction, onUpdate: NoAction)
  successors      DiplomaticDocument[]     @relation("DocumentHistory")

  @@id([worldId, id])
  @@unique([worldId, requestId])
  @@index([worldId, fromNationId, id])
  @@index([worldId, toNationId, id])
  @@index([worldId, previousId])
}

model BattleLog {
  worldId    String
  tick       Int
  attackerId Int
  generalId  Int
  text       String
  phases     Json?
  world      World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  general    General @relation(fields: [worldId, generalId], references: [worldId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([worldId, tick, attackerId, generalId])
}

enum UserStatus {
  ACTIVE
  SANCTIONED
  WITHDRAWN
}

enum UserRole {
  USER
  ADMIN
}

enum AuditActorKind {
  ADMIN
  CLI
  ENGINE
}

model User {
  npcEntryDrafts NpcEntryDraft[]
  portrait               AccountPortrait?
  notificationOutbox     NotificationOutbox[]
  notificationGeneration Int                  @default(0)
  notificationTarget     NotificationTarget?
  id                     String               @id @default(uuid())
  email                  String               @unique
  passwordHash           String
  status                 UserStatus           @default(ACTIVE)
  role                   UserRole             @default(USER)
  createdAt              DateTime             @default(now())
  emailVerifiedAt        DateTime?
  withdrawnAt            DateTime?
  retentionPurgedAt      DateTime?
  sessions               Session[]
  accountTokens          AccountToken[]
  consents               ConsentRecord[]
  generals               General[]
  sanctions              Sanction[]
  loginRecords           LoginRecord[]
  worldCreateRequests    WorldCreateRequest[]
  heritageAccount        HeritageAccount?
  heritageEntries        HeritageEntry[]
  resourceEditorGrant    ResourceEditorGrant?
  seasonGenerals         SeasonGeneral[]

  @@index([status, retentionPurgedAt, withdrawnAt, id])
}

model AccountPortrait {
  id      Int    @id @default(autoincrement())
  userId  String @unique
  png     Bytes
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResourceEditorGrant {
  userId    String   @id
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationTargetStatus {
  ACTIVE
  DISABLED
}

model NotificationTarget {
  id             String                   @id @default(uuid())
  userId         String                   @unique
  kind           String                   @default("DISCORD")
  endpoint       String
  last4          String
  events         String[]
  status         NotificationTargetStatus @default(ACTIVE)
  disabledReason String?
  verifiedAt     DateTime
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationOutboxStatus {
  PENDING
  SENDING
  RETRY
  SENT
  UNKNOWN
  GAVE_UP
}

model NotificationOutbox {
  id            String                   @id @default(uuid())
  worldId       String
  userId        String
  event         String
  payload       Json
  dedupeKey     String                   @unique
  status        NotificationOutboxStatus @default(PENDING)
  attempts      Int                      @default(0)
  nextAttemptAt DateTime                 @default(now()) @db.Timestamptz(3)
  claimId       String?
  claimedAt     DateTime?                @db.Timestamptz(3)
  targetId      String?
  generation    Int?
  resultCode    String?
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  world         World                    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt, id])
  @@index([userId])
}

model NotificationDispatchGate {
  id           String    @id
  blockedUntil DateTime? @db.Timestamptz(3)
}

model HeritageAccount {
  userId  String @id
  balance Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: NoAction)
}

model HeritageEntry {
  id        BigInt   @id @default(autoincrement())
  userId    String
  key       String
  kind      String
  worldId   String?
  delta     Int
  detail    Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@unique([userId, key])
  @@index([userId, id])
  @@index([worldId, kind])
}

model LoginRecord {
  id             BigInt   @id @default(autoincrement())
  userId         String
  at             DateTime @default(now()) @db.Timestamptz(3)
  success        Boolean
  ipHash         String   @db.VarChar(64)
  deviceHash     String?  @db.VarChar(64)
  hashKeyVersion Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([hashKeyVersion, ipHash, at])
  @@index([hashKeyVersion, deviceHash, at])
}

model AdminSanctionRequest {
  actorUserId    String
  idempotencyKey String
  requestHash    String
  sanctionId     String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@id([actorUserId, idempotencyKey])
  @@index([sanctionId])
}

model Sanction {
  id         String    @id @default(uuid())
  userId     String
  worldId    String?
  reason     String
  expiresAt  DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  liftedAt   DateTime?
  liftedBy   String?
  liftReason String?
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction)
  world      World?    @relation(fields: [worldId], references: [id], onDelete: NoAction)

  @@index([userId, liftedAt])
  @@index([worldId])
}

model AuditLog {
  id           BigInt         @id @default(autoincrement())
  at           DateTime       @default(now())
  actorKind    AuditActorKind
  actorUserId  String?
  action       String
  targetType   String
  targetId     String?
  worldId      String?
  reason       String?
  payload      Json
  inputEventId BigInt?

  @@index([at])
  @@index([actorUserId, at])
  @@index([worldId, at])
}

enum AccountTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AccountToken {
  id        String              @id
  userId    String
  purpose   AccountTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

enum ConsentDocType {
  TERMS
  PRIVACY
}

// 발행한 판의 본문·시행일을 고정한다. 사용자와 게임 데이터는 담지 않는다.
model LegalDocumentVersion {
  docType     ConsentDocType
  version     String
  effectiveAt DateTime
  bodySha256  String

  @@id([docType, version])
}

model ConsentRecord {
  id       String         @id @default(uuid())
  userId   String
  docType  ConsentDocType
  version  String
  agreedAt DateTime       @default(now())
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, docType, version])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Diplomacy {
  worldId   String
  nationA   Int
  nationB   Int
  state     DiplomacyState
  untilTick Int
  world     World          @relation(fields: [worldId], references: [id], onDelete: Cascade)
  a         Nation         @relation("NationA", fields: [worldId, nationA], references: [worldId, id], onDelete: NoAction)
  b         Nation         @relation("NationB", fields: [worldId, nationB], references: [worldId, id], onDelete: NoAction)

  @@id([worldId, nationA, nationB])
}

enum InputEventStatus {
  PENDING
  APPLIED
  REJECTED
}

model InputEvent {
  id             BigInt           @id @default(autoincrement())
  worldId        String
  userId         String
  generalId      Int?
  kind           String
  idempotencyKey String
  payload        Json
  status         InputEventStatus @default(PENDING)
  sequence       Int?
  stepTick       Int?
  tick           Int?
  result         Json?
  createdAt      DateTime         @default(now())
  world          World            @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, userId, idempotencyKey])
  @@unique([worldId, sequence])
  @@index([worldId, status, id])
}

model NationHistory {
  worldId  String
  tick     Int
  nationId Int
  data     Json
  world    World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, tick, nationId])
}

model YearbookSnapshot {
  worldId   String
  tick      Int
  year      Int
  month     Int
  sequence  Int
  data      Json
  stateHash String
  activeGenerals Int?
  world     World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  nations   YearbookNation[]

  @@id([worldId, tick])
}

model RemovedNation {
  worldId         String
  nationId        Int
  name            String
  color           String
  removedSequence Int
  removedTick     Int
  finalSummary    Json?
  world           World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, nationId])
}

model YearbookNation {
  worldId  String
  tick     Int
  nationId Int
  name     String
  color    String
  power    Int?
  troops   Int?
  snapshot YearbookSnapshot @relation(fields: [worldId, tick], references: [worldId, tick], onDelete: Cascade)

  @@id([worldId, tick, nationId])
}

model RankingSnapshot {
  worldId  String @id
  tick     Int
  year     Int
  month    Int
  generals Json
  nations  Json
  world    World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
}

model PublicMapSnapshot {
  worldId String
  takenAt DateTime
  tick    Int
  year    Int
  month   Int
  data    Json
  world   World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([worldId, takenAt])
}

enum MessageScope {
  PRIVATE
  NATION
  DIPLOMACY
  WORLD
}

model Message {
  id                String        @id @default(uuid())
  worldId           String
  scope             MessageScope
  senderId          Int?
  senderNationId    Int?
  recipientId       Int?
  recipientNationId Int?
  fromParty         Json
  toParty           Json?
  body              String
  sentAt            DateTime      @default(now()) @db.Timestamptz(3)
  deletedAt         DateTime?     @db.Timestamptz(3)
  year              Int
  month             Int
  world             World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  reads             MessageRead[]

  @@unique([worldId, id])
  @@index([worldId, scope, sentAt, id])
  @@index([worldId, senderId, sentAt])
}

model NationBoardPost {
  id         String   @id @default(uuid())
  worldId    String
  nationId   Int
  confidential Boolean
  authorName String
  portraitId Int?
  title      String
  body       String
  sentAt     DateTime @default(now())
  world      World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  replies    NationBoardReply[]

  @@index([worldId, nationId, confidential, sentAt, id])
}

model NationBoardReply {
  id         String   @id @default(uuid())
  postId     String
  authorName String
  portraitId Int?
  body       String
  sentAt     DateTime @default(now())
  post       NationBoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sentAt, id])
}

model MessageRead {
  worldId   String
  messageId String
  generalId Int
  message   Message @relation(fields: [worldId, messageId], references: [worldId, id], onDelete: Cascade)
  general   General @relation(fields: [worldId, generalId], references: [worldId, id], onDelete: Cascade)

  @@id([messageId, generalId])
}

enum NoticeScope {
  LOBBY
  WORLD
}

model Notice {
  id          String      @id @default(uuid())
  scope       NoticeScope
  worldId     String?
  title       String?
  body        String
  pinned      Boolean     @default(false)
  publishedAt DateTime    @default(now()) @db.Timestamptz(3)
  hiddenAt    DateTime?   @db.Timestamptz(3)
  revision    Int         @default(0)
  world       World?      @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([scope, worldId, publishedAt, id])
}

// 감사 기록처럼 원래 월드 삭제 뒤에도 재시도 결과를 보존한다.
model AdminNoticeRequest {
  actorUserId    String
  idempotencyKey String
  requestHash    String
  noticeId       String
  revision       Int
  hidden         Boolean
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@id([actorUserId, idempotencyKey])
}

enum GameResourceKind {
  MAP
  SCENARIO
  UNIT_SET
  STAT_RULES
  PORTRAIT_MAP
}

enum GameResourceStatus {
  DRAFT
  PUBLISHED
}

model GameResource {
  background  MapBackground?
  id          String             @id @default(uuid())
  kind        GameResourceKind
  name        String
  version     Int
  status      GameResourceStatus
  content     Json // jsonb. 원본 JSON 전체
  contentHash String // hashState(content), 소문자 16진수 64자리
  source      String // 출처와 라이선스 한 줄
  createdBy   String? // 내장 판은 null. 사용자 관계는 T3-05·T4-78
  createdAt   DateTime           @default(now())
  publishedAt DateTime?
  revision    Int                @default(0)
  updatedBy   String?
  updatedAt   DateTime?
  publishedBy String?

  @@unique([kind, name, version])
}

model MapBackground {
  resourceId     String       @id
  resource       GameResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  mapContentHash String
  sha256         String
  bytes          Int
  width          Int
  height         Int
  imageCommit    String
  createdAt      DateTime     @default(now())
}

enum ReleaseOperation {
  DEPLOY
  ROLLBACK
}

enum ReleaseRequestStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  NEEDS_OWNER
}

model ReleaseControl {
  id              String   @id
  currentRevision String
  candidates      Json
  seenAt          DateTime
}

model ReleaseRequest {
  id               String               @id
  actorUserId      String
  operation        ReleaseOperation
  expectedRevision String
  targetRevision   String
  manifestSha256   String
  status           ReleaseRequestStatus @default(QUEUED)
  requestedAt      DateTime             @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  @@index([status, requestedAt])
}
