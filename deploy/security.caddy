# T3-04 검토용 snippet. T2-15의 HTTPS site 블록에서 import한다.
# 실제 서비스 설치·기동·배포 명령은 포함하지 않는다.
(game_security) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' https://raw.githubusercontent.com https://rawcdn.githack.com; connect-src 'self' https://raw.githubusercontent.com/opensamguk/opensamguk-images/9ac9f688406105e9ff84db9aa164eea6d4ee99ba/public/map3d/textures/; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
	}
}
