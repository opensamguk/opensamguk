# 비밀값은 쓰지 않는다. 실제 설정은 Git 밖 절대 경로에 보관한다.
# 명령에는 --project-name, --env-file, -f를 모두 명시한다.
# 이미지 값은 release manifest의 sha256: config image ID다. pull/build는 별도 단계다.
SERVER_IMAGE=
ENGINE_IMAGE=
MIGRATE_IMAGE=
# 인증서 hostname과 정확한 외부 HTTPS origin. 운영은 외부80/443 전달이 필요하다.
PUBLIC_HOST=
PUBLIC_ORIGIN=
# 실제 운영 노출 주소와 포트는 소유자가 정한다. 리허설은127.0.0.1 고포트를 쓴다.
BIND_ADDRESS=
HTTP_PORT=
HTTPS_PORT=
MAIL_FROM=
POSTGRES_USER=
POSTGRES_DB=
# manifest로 검증한 공개 web 절대 경로. 누락 시 디렉터리를 만들지 않는다.
PUBLIC_WEB_DIRECTORY=
# 사전 생성·소유 대조한 네 volume의 정확한 이름. 자동 생성하지 않는다.
APP_SECRETS_VOLUME=
PG_SECRETS_VOLUME=
PG_DATA_VOLUME=
CADDY_DATA_VOLUME=
